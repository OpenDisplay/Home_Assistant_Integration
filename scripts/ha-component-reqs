#!/usr/bin/env python3
"""Print the HA component requirements this integration needs pinned for tests.

Home Assistant installs each component's `requirements` at runtime from that
component's own manifest.json, so they are invisible to uv/pip when resolving
this project. Tests set up the real `bluetooth`, `http` and `recorder`
components, which means their requirements -- and those of everything they
depend on -- have to be pinned explicitly in the pyproject dependency groups.
Getting this wrong shows up as an ImportError deep inside homeassistant
(e.g. `cannot import name 'BluetoothReachabilityIntent' from 'habluetooth'`).

Run this after bumping a pytest-homeassistant-custom-component pin, and paste
the output into the matching dependency group in pyproject.toml.

    scripts/ha-component-reqs              # against the synced .venv
    scripts/ha-component-reqs path/to.whl  # against a homeassistant wheel

Only hard `dependencies` are followed. `after_dependencies` (esphome, shelly,
...) are deliberately skipped: Home Assistant only sets those up if they are
already loaded, which never happens in these tests.
"""

import json
import pathlib
import sys
import zipfile

# Mirrors custom_components/opendisplay/manifest.json "dependencies".
ROOTS = ["bluetooth_adapters", "frontend", "http", "panel_custom", "recorder"]


def _collect(read_manifest) -> tuple[set[str], dict[str, str]]:
    seen: set[str] = set()
    reqs: dict[str, str] = {}

    def walk(name: str) -> None:
        if name in seen:
            return
        seen.add(name)
        manifest = read_manifest(name)
        if manifest is None:
            return
        for req in manifest.get("requirements", []):
            reqs.setdefault(req, name)
        for dep in manifest.get("dependencies", []):
            walk(dep)

    for root in ROOTS:
        walk(root)
    return seen, reqs


def main() -> int:
    if len(sys.argv) > 1:
        wheel = zipfile.ZipFile(sys.argv[1])
        names = set(wheel.namelist())

        def read_manifest(name: str) -> dict | None:
            path = f"homeassistant/components/{name}/manifest.json"
            return json.loads(wheel.read(path)) if path in names else None
    else:
        import homeassistant.components  # noqa: PLC0415

        base = pathlib.Path(homeassistant.components.__file__).parent

        def read_manifest(name: str) -> dict | None:
            path = base / name / "manifest.json"
            return json.loads(path.read_text()) if path.exists() else None

    seen, reqs = _collect(read_manifest)
    print(f"# components: {', '.join(sorted(seen))}")
    for req in sorted(reqs, key=str.lower):
        print(f'    "{req}",  # {reqs[req]}')
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
