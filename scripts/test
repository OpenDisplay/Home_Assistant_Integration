#!/usr/bin/env bash
# Run the test suite.
#
#   scripts/test              # against the pinned latest Home Assistant
#   scripts/test --min-ha     # against the hacs.json floor
#   scripts/test -k config    # any other argument is passed through to pytest

set -e

cd "$(dirname "$0")/.."

# tests/js/ (plain node --test -- see scripts/test-js's own comment) is the
# ONLY coverage for the designer panel's keyboard-containment fix; run it
# as part of this same gate so it's never skipped by accident. Not passed
# any of pytest's own arguments below ($@ is pytest-specific, e.g. -k) --
# this is a separate, much smaller suite with nothing to select within.
scripts/test-js

group="dev"
if [ "${1:-}" = "--min-ha" ]; then
    group="min-ha"
    shift
fi

exec uv run --no-default-groups --group "$group" pytest "$@"
